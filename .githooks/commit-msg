#!/bin/sh
# Reject a commit that makes an AI assistant a contributor: an AI author or
# committer, or a Co-authored-by trailer naming one. Nothing else is checked.
. "$(git rev-parse --show-toplevel)/.githooks/branding-guard.sh"

if ! coauthor_check "commit message" < "$1"; then
    cat >&2 <<'MSG'

No Co-authored-by trailer may name an AI assistant; remove that trailer,
then commit again. Do NOT use --no-verify; server-side CI enforces the same rule.
MSG
    exit 1
fi

# "Name <email> 1700000000 +0000" -> "Name <email>"
ident() { git var "$1" | sed 's/[[:space:]]*[0-9]*[[:space:]]*[-+][0-9]*$//'; }
identity_check "$(ident GIT_AUTHOR_IDENT)" "author" || exit 1
identity_check "$(ident GIT_COMMITTER_IDENT)" "committer" || exit 1
exit 0
