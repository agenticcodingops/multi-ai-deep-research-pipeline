#!/bin/sh
# Backstop: recheck every commit being pushed (catches amends, rebases,
# merges, imported commits, and anything committed with --no-verify).
# Only authorship is checked; branch names and message text are not.
. "$(git rev-parse --show-toplevel)/.githooks/branding-guard.sh"

Z40=0000000000000000000000000000000000000000
fail=0

while read -r _ localsha _ remotesha; do
    [ "$localsha" = "$Z40" ] && continue          # branch deletion
    if [ "$remotesha" = "$Z40" ]; then
        range=$(git rev-list "$localsha" --not --remotes= 2>/dev/null)
    else
        range=$(git rev-list "$remotesha..$localsha" 2>/dev/null)
    fi

    for c in $range; do
        short=$(git rev-parse --short "$c")
        git log -1 --format='%B' "$c" | coauthor_check "commit $short" || fail=1
        identity_check "$(git log -1 --format='%an <%ae>' "$c")" "author"    "$short" || fail=1
        identity_check "$(git log -1 --format='%cn <%ce>' "$c")" "committer" "$short" || fail=1
    done
done

if [ "$fail" -ne 0 ]; then
    cat >&2 <<'MSG'

Push rejected: an outgoing commit has a Co-authored-by trailer naming an AI
assistant, or an AI assistant as author or committer. Remove the trailer or
re-commit under your own identity before pushing, e.g.:
    git rebase --exec 'git commit --amend --no-edit --reset-author' <base>
MSG
    exit 1
fi
exit 0
